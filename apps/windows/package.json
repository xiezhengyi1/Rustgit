{
  "name": "rustgit-windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows desktop app (Tauri 2 + React) for the rustgit engine",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage-sidecar": "node scripts/stage-sidecar.mjs",
    "capture-fixtures": "node scripts/capture-fixtures.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
